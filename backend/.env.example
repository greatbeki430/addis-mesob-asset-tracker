# ============================================================
# FILE:   backend/.env.example
# STATUS: UPDATED - existing file, replace its whole content with this
# ============================================================
# ---- Server ----
NODE_ENV=development
PORT=5001

# ---- Database ----
MONGO_URI=mongodb://127.0.0.1:27017/mesob_gate

# ---- Auth ----
# Generate a long random string, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=12h

# ---- CORS (comma separated list of allowed front-end origins) ----
# Production example (Vercel):  CLIENT_URL=https://your-app.vercel.app   (no trailing slash needed)
# Several origins:              CLIENT_URL=https://your-app.vercel.app,http://localhost:5173
CLIENT_URL=http://localhost:5173

# ---- Business rules ----
BRANCH_NAME=Addis Ketema Branch
# Ethiopia is UTC+3 (180 minutes) and has no daylight saving time
TZ_OFFSET_MINUTES=180
# An item still outside after this many hours is flagged as "overdue"
OVERDUE_HOURS=24

# ---- Seed script (first run only, change after login) ----
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@12345
SEED_SECURITY_USERNAME=security1
SEED_SECURITY_PASSWORD=Security@123