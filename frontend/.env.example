# ============================================================
# FILE:   frontend/.env.example
# STATUS: NEW file - create it at this path
# ============================================================
# Only needed when the API is on a different address than the website (e.g. Vercel + Render).
# Leave it unset for local development - the Vite dev server proxies /api to the backend.
#
# On Vercel: Project -> Settings -> Environment Variables
#   Name:  VITE_API_URL
#   Value: https://YOUR-SERVICE.onrender.com/api        (must end with /api, no trailing slash)
# It is read at BUILD time, so redeploy after changing it.
VITE_API_URL=